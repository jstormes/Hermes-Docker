# Copy this file to ".env" (same directory as docker-compose.windows.yml)
# and fill in your key. Docker Compose loads .env automatically and injects
# OPENAI_API_KEY into both the gateway and dashboard containers, so the key
# stays out of .hermes/config.yaml (and out of git — .env is git-ignored).
#
#   cp .env.example .env      # then edit .env
#
# For the llm.stormes.net fleet this is your bearer key. It is forwarded to the
# provider as a standard "Authorization: Bearer <key>" header.
OPENAI_API_KEY=

# This .env file is the place for ANY environment variable you want to set but
# keep out of the git repo (secrets, tokens, local overrides). It is git-ignored.
# Add your own variables below — to actually pass one into the containers, also
# reference it in docker-compose.windows.yml under each service's `environment:`
# (e.g. `- MY_VAR=${MY_VAR:-}`).
