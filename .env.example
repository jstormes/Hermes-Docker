# Copy this file to ".env" (same directory as docker-compose.yml)
# and fill in your key. Docker Compose loads .env automatically and injects
# OPENAI_API_KEY into the hermes container, so the key stays out of
# .hermes/config.yaml (and out of git — .env is git-ignored).
#
#   cp .env.example .env      # then edit .env
#
# For the llm.stormes.net fleet this is your bearer key. It is forwarded to the
# provider as a standard "Authorization: Bearer <key>" header.
OPENAI_API_KEY=

# Provider base URL. The `gateway setup` wizard reads this from the environment
# and offers it as the bracketed default at the "API base URL" prompt, so you
# can just press Enter to accept it. Pre-set to the llm.stormes.net fleet.
OPENAI_BASE_URL=https://llm.stormes.net/v1

# --- Claude Code (optional) ----------------------------------------------------
# Long-lived OAuth token so the `claude` CLI inside the container authenticates
# as your logged-in Claude Pro/Max account — no browser login needed in Docker.
# Generate it on your host (where a browser is available):
#
#   claude setup-token        # prints a ~1-year token; copy it here
#
# Requires a Pro/Max/Team/Enterprise subscription. The token is inference-scoped.
# This is unrelated to OPENAI_API_KEY above (that's for the Hermes fleet); the
# two coexist fine. Treat this like a password — .env is git-ignored.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Anything else -------------------------------------------------------------
# This .env file is the place for ANY environment variable you want to set but
# keep out of the git repo (secrets, tokens, local overrides). It is git-ignored.
# Add your own variables below — to actually pass one into the container, also
# reference it in docker-compose.yml under the hermes service's `environment:`
# (e.g. `- MY_VAR=${MY_VAR:-}`).
#
# Native Linux only: set HERMES_UID / HERMES_GID to your host user so files the
# agent writes to ./projects are owned by you (no effect on Docker Desktop).
#   HERMES_UID=1000
#   HERMES_GID=1000
