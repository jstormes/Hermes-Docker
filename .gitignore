# ── Secrets — never commit ──────────────────────────────────────────────
.env
*.env
!*.env.example
.hermes/.env

# ── Hermes data dir (.hermes == /opt/data) ──────────────────────────────
# Default-deny everything the gateway writes here (runtime state + secrets),
# then re-include ONLY the committable, secret-free files. config.yaml is safe
# to commit because it holds ${VAR} references, not literal secrets.
.hermes/*
!.hermes/config.yaml
!.hermes/SOUL.md
!.hermes/USER.md
# Boot writes a timestamped backup before migrating config; it can contain a
# literal expanded key from an earlier run — never commit it.
.hermes/config.yaml.bak-*

# Custom skills: keep them in a tracked projects/skills/ dir and point
# config.yaml -> skills.external_dirs at it, rather than committing the bundled
# builtin tree that boot populates under .hermes/skills/.

# ── IDE / editor ────────────────────────────────────────────────────────
.idea/
.vscode/

# ── OS noise ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
