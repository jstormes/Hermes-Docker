# Copy this file to ".env" (same directory as docker-compose.yml)
# and fill in your key. Docker Compose loads .env automatically and injects
# OPENAI_API_KEY into the hermes container, so the key stays out of
# .hermes/config.yaml (and out of git — .env is git-ignored).
#
#   cp .env.example .env      # then edit .env
#
# For the llm.stormes.net fleet this is your bearer key. It is forwarded to the
# provider as a standard "Authorization: Bearer <key>" header.
OPENAI_API_KEY=

# Provider base URL. The `gateway setup` wizard reads this from the environment
# and offers it as the bracketed default at the "API base URL" prompt, so you
# can just press Enter to accept it. Pre-set to the llm.stormes.net fleet.
OPENAI_BASE_URL=https://llm.stormes.net/v1

# --- Instance identity (set per instance) --------------------------------------
# HERMES_PROJECT names this instance's container as hermes-<project>; HERMES_PORT
# is the host loopback port the dashboard is published on. docker-compose.yml
# reads BOTH via ${...} interpolation, so you never hand-edit the compose file to
# name an instance. Pick a short lowercase slug (letters/digits/hyphens) and a
# port unique on this host (the first instance can keep 9119).
HERMES_PROJECT=
HERMES_PORT=9119

# --- Instance isolation: run-as user + resource ceilings (set per instance) -----
# The container runs as this host UID/GID. On the hermes1 fleet, set them to the
# instance's DEDICATED user (hermes-<project>, uid 1000X) so a compromised agent is
# confined to its own uid and can't touch another instance's files. HERMES_HOME_MODE
# keeps /opt/data at setgid 2770 so the operator (in the instance group) can reach
# .hermes without sudo. See PROVISIONING-PHASE-1.md Steps 3 & 5.
#   HERMES_UID=10003
#   HERMES_GID=10003
#   HERMES_HOME_MODE=2770
#
# Resource ceilings (optional; fleet DoS containment). Guards so one runaway/leaking
# instance can't starve the host — defaults suit a normal browsing agent; raise for
# heavy browser/media workloads.
#   HERMES_MEM_LIMIT=4g      # max RAM (e.g. 2g, 6g)
#   HERMES_CPUS=2            # max CPU cores (fractional ok, e.g. 1.5)
#   HERMES_PIDS_LIMIT=2048   # max processes/threads (fork-bomb guard)
#   HERMES_NOFILE=8192       # max open file descriptors (soft==hard)

# --- Dashboard login secrets (set per instance) --------------------------------
# .hermes/config.yaml references these via ${...} so the committed config stays
# secret-free. HERMES_DASH_PW is the dashboard PLAINTEXT password (Hermes hashes
# it in memory — do NOT use a scrypt hash here; compose mangles the $ in it).
# HERMES_DASH_SECRET signs sessions and must survive restarts — generate a random
# 32-byte token. Both MUST be $-free. Generate the secret with:
#   docker compose run --rm --entrypoint /opt/hermes/.venv/bin/python3 hermes \
#     -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_DASH_PW=
HERMES_DASH_SECRET=

# --- Claude Code (optional) ----------------------------------------------------
# Long-lived OAuth token so the `claude` CLI inside the container authenticates
# as your logged-in Claude Pro/Max account — no browser login needed in Docker.
# Generate it on your host (where a browser is available):
#
#   claude setup-token        # prints a ~1-year token; copy it here
#
# Requires a Pro/Max/Team/Enterprise subscription. The token is inference-scoped.
# This is unrelated to OPENAI_API_KEY above (that's for the Hermes fleet); the
# two coexist fine. Treat this like a password — .env is git-ignored.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Anything else -------------------------------------------------------------
# This .env file is the place for ANY environment variable you want to set but
# keep out of the git repo (secrets, tokens, local overrides). It is git-ignored.
# Add your own variables below — to actually pass one into the container, also
# reference it in docker-compose.yml under the hermes service's `environment:`
# (e.g. `- MY_VAR=${MY_VAR:-}`).
#
# (Native-Linux run-as identity HERMES_UID / HERMES_GID / HERMES_HOME_MODE and the
# resource-ceiling vars are documented in the "Instance isolation" section above.)
